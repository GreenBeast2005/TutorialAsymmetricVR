--- !u!114 &110536404
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 110536402}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82f5eb494af680e47a3a0428dc3f4a2f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialMessages:
  - Welcome to the Tutorial!
  - Lets get you moving, try using WASD or the Arrow Keys to walk around.
  - Awesome now use the mouse to look around the room!
  - That black dot in the middle of the screen is your virtual eye.
  - When prompted to look at something that means to move that black dot over that
    object.
  - Go look at one of those black cubes on the shelf.
  - When you look at an object and a Red Outline appears, that means you can pick
    it up.
  - Now left click with the mouse to pick up the cube.
  - Place 3 of those cubes on the coffee table in front of the sofa.
  - Tutorial Complete!
  - Now go click on the door to move to the actual area.
  messageTime: 5
  tutorialEvents: {fileID: 11400000, guid: 77a6048f173686746a59883c60aa7f08, type: 2}
  eventCount: 10
